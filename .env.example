# OpenRouter API key — the AI advisor uses this to answer grounded questions
# about the universities in this guide. Copy this file to `.env` and fill in
# your real key. Never commit `.env`.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx
# Optional: override the default model used by the advisor.
# Paid models (e.g. openai/gpt-4o-mini) need credits on your OpenRouter account.
# Free models (with a :free suffix) work without credits but are rate-limited.
# OPENROUTER_MODEL=google/gemma-4-31b-it:free